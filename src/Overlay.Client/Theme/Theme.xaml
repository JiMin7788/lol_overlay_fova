<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ================================================================
         Shared design system for the LoL Overlay desktop app.
         Modern dark, League-inspired. Every color / typography / control
         style lives here so views never use ad-hoc colors or chrome.
         Rules + scales: docs/design/DESIGN_SYSTEM.md. Literal sizes, radii
         and colors in view code are ratcheted by UiLiteralRatchetTests.
         ================================================================ -->

    <!-- ── Palette ────────────────────────────────────────────────────── -->
    <Color x:Key="BgColor">#0F1117</Color>
    <Color x:Key="SurfaceColor">#181B22</Color>
    <Color x:Key="SurfaceHiColor">#20242E</Color>
    <Color x:Key="BorderColor">#2A2F3A</Color>
    <Color x:Key="TextColor">#E6E8EC</Color>
    <Color x:Key="TextDimColor">#8B929F</Color>
    <Color x:Key="AccentColor">#C8AA6E</Color>
    <Color x:Key="AccentBlueColor">#3B82F6</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="WarningColor">#F2C14E</Color>
    <!-- Third text level: axis labels, empty bars, de-emphasized meta. -->
    <Color x:Key="TextFaintColor">#5B6472</Color>
    <Color x:Key="AccentHoverColor">#D8BC82</Color>
    <Color x:Key="AccentPressedColor">#B7995E</Color>
    <!-- Team + damage-type colors (champ select, kill timing, search results). -->
    <Color x:Key="AllyColor">#4C8DFF</Color>
    <Color x:Key="EnemyColor">#E5484D</Color>
    <Color x:Key="DmgPhysicalColor">#E8722A</Color>
    <Color x:Key="DmgMagicColor">#4C8DFF</Color>
    <!-- Dark veil laid over icon art behind a letter badge. -->
    <Color x:Key="ScrimColor">#AA000000</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHi" Color="{StaticResource SurfaceHiColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="Ally" Color="{StaticResource AllyColor}" />
    <SolidColorBrush x:Key="Enemy" Color="{StaticResource EnemyColor}" />
    <SolidColorBrush x:Key="DmgPhysical" Color="{StaticResource DmgPhysicalColor}" />
    <SolidColorBrush x:Key="DmgMagic" Color="{StaticResource DmgMagicColor}" />
    <SolidColorBrush x:Key="DmgTrue" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}" />

    <!-- Fova brand marks: steel-white scan + hot red contact (see brand kit) -->
    <SolidColorBrush x:Key="FovaScan" Color="#D6E2F2" />
    <SolidColorBrush x:Key="FovaContact" Color="#FF5E44" />

    <!-- Per-slot accent colors for combo skill chips (P/Q/W/E/R/AA). P/Q/R reuse the palette
         instead of copying its hex, so a palette change cannot leave the chips behind. -->
    <SolidColorBrush x:Key="SlotP" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SlotQ" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="SlotW" Color="#22C55E" />
    <SolidColorBrush x:Key="SlotE" Color="#A855F7" />
    <SolidColorBrush x:Key="SlotR" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SlotAA" Color="#94A3B8" />

    <!-- ── Scales ─────────────────────────────────────────────────────────
         Type ramp: Display 22 · Title 17 · Subtitle 15 · Body 13 · Caption 12 · Micro 10
         (inputs and nav labels keep 14). Radius: 0 icon frames · 4 small · 6 control ·
         10 card · pill = height/2. Spacing: 2 / 4 / 8 / 12 / 16 / 24, page gutter 28. -->
    <sys:Double x:Key="FontDisplay">22</sys:Double>
    <sys:Double x:Key="FontTitle">17</sys:Double>
    <sys:Double x:Key="FontSubtitle">15</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontMicro">10</sys:Double>
    <sys:Double x:Key="FontInput">14</sys:Double>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>

    <!-- ── Typography ─────────────────────────────────────────────────── -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- Title of a card or panel inside a page (one step below SectionHeader). -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Small dim heading that opens a group of rows inside a card ("앱", "단축키"). -->
    <Style x:Key="GroupCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Label of one setting / form field. Always paired with an optional HintText below it. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Explanatory text under a field, empty states, and page/card meta lines. -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- Default TextBlock inherits the app font + body color -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- ── Card ───────────────────────────────────────────────────────── -->
    <!-- Top-level container on a page. Banners, help sections and the champ-select panel are
         cards too: one recipe, so their edges line up. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- A card nested inside a card (saved combo, recommendation, kill-timing panel). -->
    <Style x:Key="CardInset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ── Primary button (Accent bg, dark text) ──────────────────────── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Bg}" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHi}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Secondary / ghost button ───────────────────────────────────── -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHi}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary action inside a dense row (card footers, inline tools). -->
    <Style x:Key="CompactGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Glyph-only button (✎, ✕, +). Square-ish hit target, same chrome as Ghost. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="30" />
    </Style>

    <!-- Destructive action. Danger-tinted text; arms to a filled state for the confirm click. -->
    <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>

    <!-- ── TextBox ────────────────────────────────────────────────────── -->
    <Style x:Key="ThemedTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontInput}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <!-- Grid centers the content host vertically; the host itself must NOT be
                             height-constrained or descenders (g/y/p) and tall Hangul clip. -->
                        <Grid>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource TextDim}" IsHitTestVisible="False"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Visibility="Collapsed" />
                            <!-- No Margin=Padding here: TextBox applies its Padding to the text itself,
                                 so a margin doubled it and every input rendered ~57 tall instead of
                                 matching the 38px ComboBox beside it. The placeholder above still
                                 takes the Padding so it sits where the text will. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}" />

    <!-- ── ListBox ────────────────────────────────────────────────────── -->
    <Style x:Key="ThemedListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="{StaticResource SurfaceHi}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedListBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer Focusable="False" Padding="0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ComboBox ───────────────────────────────────────────────────── -->
    <Style x:Key="ComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{StaticResource SurfaceHi}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                       FontSize="11" Foreground="{StaticResource TextDim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontInput}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{StaticResource ComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,32,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextDim}" Margin="12,0,32,0"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Nav-rail item (RadioButton) ────────────────────────────────── -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <!-- The app-wide implicit TextBlock style sets Foreground=Text, which beat the inherited
             TextDim below, so every nav icon read as selected. A neutral TextBlock style in scope
             lets the icon and label inherit the item's state colour instead. -->
        <Style.Resources>
            <Style TargetType="TextBlock" />
        </Style.Resources>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="46" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="root" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Margin="10,2">
                        <Grid>
                            <Border x:Name="bar" Width="3" HorizontalAlignment="Left"
                                    CornerRadius="2" Background="{StaticResource Accent}" Opacity="0"
                                    Margin="0,8" />
                            <ContentPresenter VerticalAlignment="Center" Margin="18,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceHi}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceHi}" />
                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Hidden-scrollbar ScrollViewer ──────────────────────────────────
         Content still scrolls via the mouse wheel; the visual scrollbar is
         never drawn. Used everywhere in the home app so no raw WPF scrollbar
         is visible. -->
    <Style x:Key="HiddenScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ── Settings sub-navigation pill (RadioButton) ─────────────────────
         Horizontal pills used inside the Settings view to switch between the
         기본 / 언어 / 오버레이 sub-sections. Checked = accent-filled. -->
    <Style x:Key="SubNavPill" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="16" Padding="16,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Slider (opacity / size) ────────────────────────────────────────
         Minimal themed track + accent thumb. The Track positions the thumb
         from Minimum/Maximum/Value; decrease/increase repeat buttons are
         intentionally omitted for a clean look. -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="16" Height="16" Fill="{StaticResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedSlider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceHi}" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle switch (ToggleButton) ───────────────────────────────────
         iOS-style pill switch used for movable / per-item enable toggles.
         Off = dim thumb on a surface track; On = accent track, thumb moves
         right. -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="13"
                            Background="{StaticResource SurfaceHi}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Ellipse x:Name="thumb" Width="18" Height="18"
                                 Fill="{StaticResource TextDim}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="thumb" Property="Fill" Value="{StaticResource Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Combo skill chip (drag-drop palette / sequence badge) ──────────
         A square showing the slot letter (P/Q/W/E/R/AA). The accent color is set
         per-slot in code-behind (see ComboSettingsView). Square (not rounded) corners
         so the border matches the real square DDragon ability icon art it frames. -->
    <Style x:Key="SkillChip" TargetType="Border">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Global themed ToolTip (2026-07-25 feedback: system tooltips rendered white-on-white
         against the dark theme because app-wide TextBlock foregrounds are light). Implicit
         style so every tooltip in the app — rune editor, comp board, buttons — is readable. -->
    <!-- (design pass) Rounded, width-capped and wrapping: long explanations used to render as one
         screen-wide line. The TextBlock style inside the template is what wraps plain-string
         tooltips — app-level implicit TextBlock styles do not reach into control templates. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="LineHeight" Value="18" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Implicit control styles ────────────────────────────────────────
         Every CheckBox / RadioButton / Slider / ScrollBar a view creates without a Style used to
         render with raw WPF chrome (white system glyphs on the dark surface). These make the
         unstyled case themed; explicit styles (NavItem, SubNavPill, ThemedSlider) still win. -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="16" Height="16" VerticalAlignment="Center"
                                Background="{StaticResource SurfaceHi}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}">
                            <Path x:Name="check" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="{StaticResource Bg}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Margin="-1" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="ring" Fill="{StaticResource SurfaceHi}"
                                     Stroke="{StaticResource Border}" StrokeThickness="1" />
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Accent}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource ThemedSlider}" />

    <!-- Thin scrollbar for the few places that show one (dropdown lists, capped result lists).
         Page views still hide theirs (HiddenScroll). MinWidth/MinHeight reset the system theme's
         17px minimum, which would otherwise win over Width. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bd" Background="{StaticResource Border}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource TextFaint}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource TextDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" Margin="2,2" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" Margin="2,2" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
