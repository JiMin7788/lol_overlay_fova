<Window x:Class="Overlay.Client.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Fova"
        Width="1040" Height="830" MinWidth="900" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource AppFont}"
        Icon="fova.ico">
    <!-- RootGrid carries a LayoutTransform ScaleTransform (set in code-behind) so the whole
         UI scales up to ~1.5x on large screens and shrinks to fit on small ones. Layout is
         scaled, not a bitmap, so text stays crisp. -->
    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left nav rail ─────────────────────────────────────────── -->
        <!-- Icon-only (60px) by default; expands to the full 200px on hover, revealing the
             title/label text, and collapses back on mouse-leave. The ColumnDefinition above is
             Auto so the Grid sizes to this Border's (animated) Width — a GridLength can't be
             animated directly, so Width is the real sizing mechanism instead. ClipToBounds
             prevents label text from visibly overflowing the rail while it's still collapsed
             (the labels also fade via Opacity, animated alongside Width below). -->
        <Border x:Name="NavRail" Grid.Column="0" Width="60" HorizontalAlignment="Left" ClipToBounds="True"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">
            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="200" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="AppTitleLabel" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavHomeLabel" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavSearchLabel" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavComboLabel" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavStatsLabel" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavSettingsLabel" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavHelpLabel" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Border.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="60" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="AppTitleLabel" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavHomeLabel" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavSearchLabel" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavComboLabel" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavStatsLabel" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavSettingsLabel" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="NavHelpLabel" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="18,26,0,28">
                    <!-- Fova mark: FOV ring (Aperture) — steel arc = your field of view, red arc =
                         the blind spot fova fills (the "+a"); centre dot = focus. fova = FOV + a.
                         Drawn on a 64-unit canvas (matches the brand kit) and scaled by the Viewbox.
                         Icon-only when the rail is collapsed; the "fova." wordmark to its right
                         fades in on hover via the AppTitleLabel Opacity animation above. -->
                    <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                        <Canvas Width="64" Height="64">
                            <!-- base field of view (steel, ~270deg arc) -->
                            <Path Data="M38.84,50.79 A 20,20 0 1 1 50.79,25.16"
                                  Stroke="{StaticResource FovaScan}" StrokeThickness="6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <!-- blind spot fova fills (red arc = the +a) -->
                            <Path Data="M50.79,25.16 A 20,20 0 0 1 38.84,50.79"
                                  Stroke="{StaticResource FovaContact}" StrokeThickness="6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <!-- focus point -->
                            <Ellipse Canvas.Left="28.4" Canvas.Top="28.4" Width="7.2" Height="7.2"
                                     Fill="{StaticResource FovaScan}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="AppTitleLabel" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0">
                        <Run Text="fova" Foreground="{StaticResource Text}" /><Run Text="." Foreground="{StaticResource FovaContact}" />
                    </TextBlock>
                </StackPanel>

                <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="nav"
                             IsChecked="True" Checked="Nav_Home">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSubtitle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock x:Name="NavHomeLabel" Text="홈" FontSize="{StaticResource FontInput}" VerticalAlignment="Center" Opacity="0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSearch" Style="{StaticResource NavItem}" GroupName="nav"
                             Checked="Nav_Search">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSubtitle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock x:Name="NavSearchLabel" Text="유저검색" FontSize="{StaticResource FontInput}" VerticalAlignment="Center" Opacity="0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavCombo" Style="{StaticResource NavItem}" GroupName="nav"
                             Checked="Nav_Combo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSubtitle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock x:Name="NavComboLabel" Text="콤보설정" FontSize="{StaticResource FontInput}" VerticalAlignment="Center" Opacity="0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavStats" Style="{StaticResource NavItem}" GroupName="nav"
                             Checked="Nav_Stats">
                    <StackPanel Orientation="Horizontal">
                        <!-- MDL2 "AreaChart" — the statistics table -->
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSubtitle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock x:Name="NavStatsLabel" Text="통계" FontSize="{StaticResource FontInput}" VerticalAlignment="Center" Opacity="0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav"
                             Checked="Nav_Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSubtitle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock x:Name="NavSettingsLabel" Text="설정" FontSize="{StaticResource FontInput}" VerticalAlignment="Center" Opacity="0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavHelp" Style="{StaticResource NavItem}" GroupName="nav"
                             Checked="Nav_Help">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSubtitle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock x:Name="NavHelpLabel" Text="도움말" FontSize="{StaticResource FontInput}" VerticalAlignment="Center" Opacity="0" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ── Content area ──────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- M33 champ-select panel: Auto-height strip, collapsed (zero height) outside
                     champ select. Unlike the M29 slot below it is transient by design — it may
                     shift the view when champ select starts/ends, which is exactly when the user
                     is looking at the client anyway. -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <!-- M29 ad slot: 130px (90px 728x90 leaderboard + 16/24 margins) reserved ONLY while
                     a creative is on screen. (loop 521) The height is driven from code-behind
                     (SetAdSlotReserved): an empty, failed, or in-game-dormant slot reclaims the row
                     to 0 so it never renders as a black band clipping the content, and it expands
                     back the moment a creative loads. Starts at 0. -->
                <RowDefinition x:Name="AdRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <!-- (design pass) Bottom margin keeps the header controls off the divider below, and the
                 status pill takes the button's height so both sit on one line. -->
            <Grid Grid.Row="0" Margin="28,16,28,14">
                <TextBlock x:Name="SectionTitle" Text="홈" Style="{StaticResource SectionHeader}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PreviewToggle" Content="오버레이 미리보기" Style="{StaticResource GhostButton}"
                            Click="PreviewToggle_Click" Margin="0,0,8,0" />
                    <Border x:Name="StatusPill" Background="{StaticResource SurfaceHi}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Height="{Binding ActualHeight, ElementName=PreviewToggle}"
                            CornerRadius="17" Padding="14,0">
                        <TextBlock x:Name="StatusText" Text="&#x25CF; 게임 대기 중" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" Background="{StaticResource Border}" VerticalAlignment="Bottom"
                    Margin="28,0,28,0" />

            <!-- M33 champ-select panel host; inserted in code-behind (needs the composition's
                 LcuConnector + preset store). Collapsed row outside champ select. -->
            <StackPanel x:Name="HomeDashboardExtras" Grid.Row="1">
                <!-- (2026-10-19) League's game.cfg says WindowMode=0 (fullscreen), where the overlay
                     cannot draw over the game. Re-checked every few seconds; hides itself once the
                     user switches to borderless or windowed. -->
                <Border x:Name="FullscreenWarning" Style="{StaticResource Card}" Margin="28,16,28,0"
                        BorderBrush="{StaticResource Warning}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="FullscreenWarningTitle" Style="{StaticResource CardTitle}"
                                   Foreground="{StaticResource Warning}" />
                        <TextBlock x:Name="FullscreenWarningText" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextDim}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <!-- First-run Flash-key question (2026-07-25): asked ONCE at app start; never
                     shown again while champSelect.flashKey holds a value. -->
                <!-- (design pass) Banners are Cards with a right-docked action group, so their edges
                     and padding match the page cards below them. Text is set from Localization. -->
                <Border x:Name="FlashKeyBanner" Style="{StaticResource Card}" Margin="28,16,28,0" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FlashKeyD" Content="D 점멸" Style="{StaticResource GhostButton}" />
                            <Button x:Name="FlashKeyF" Content="F 점멸" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="FlashKeyBannerText" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                </Border>
                <!-- First-run guide (1.0 plan, must-add 4): what League needs, how to get a combo on
                     screen, how to pick the target, and the toggle key. Shown once
                     (general.firstRunGuideShown); Help has a button that brings it back. -->
                <Border x:Name="FirstRunGuide" Style="{StaticResource Card}" Margin="28,16,28,0" Visibility="Collapsed">
                    <!-- Actions under the steps, not beside them: the steps get the full width, so
                         Korean lines no longer break mid-word against the button column. -->
                    <StackPanel>
                        <TextBlock x:Name="FirstRunGuideTitle" Text="Fova 시작하기" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="FirstRunGuideText" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextDim}" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="FirstRunOpenCombo" Content="콤보설정 열기" Style="{StaticResource PrimaryButton}" />
                            <Button x:Name="FirstRunDismiss" Content="닫기" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- M39 one-time telemetry disclosure (2026-08-26): shown once, only while telemetry
                     is actually configured+on; both buttons dismiss it forever (telemetry.noticeShown). -->
                <Border x:Name="TelemetryNotice" Style="{StaticResource Card}" Margin="28,16,28,0" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TelemetryOk" Content="확인" Style="{StaticResource GhostButton}" />
                            <Button x:Name="TelemetryOptOut" Content="보내지 않기" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TelemetryNoticeText" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Active view host -->
            <ContentControl x:Name="MainContent" Grid.Row="2" Margin="28,16,28,0"
                            VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />

            <!-- Ad slot host; the AdBanner control is inserted in code-behind (it needs the
                 AppComposition's AdSlotService). -->
            <ContentControl x:Name="AdSlot" Grid.Row="3" Margin="28,6,28,8" />
        </Grid>
    </Grid>
</Window>
