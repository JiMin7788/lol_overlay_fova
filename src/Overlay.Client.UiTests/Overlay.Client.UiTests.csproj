<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows SDK TFM gives the WinRT projection that Windows.Media.Ocr needs. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The M45 editor cases (M45EditorTests), read next to the test assembly. -->
    <None Update="M45\m45_cases.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Core only: the app under test is the separate build copy in artifacts/uitest/app
         (AppCopyFixture), never a project reference to Overlay.Client. -->
    <ProjectReference Include="..\Overlay.Core\Overlay.Core.csproj" />
  </ItemGroup>

</Project>
